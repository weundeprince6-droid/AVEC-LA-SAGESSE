# Copiez ce fichier en « .env » (dans le dossier functions) puis remplissez les valeurs.
# Identifiant du numéro WhatsApp (« Phone number ID » dans Meta > WhatsApp > Configuration de l'API). Ce n'est PAS le numéro de téléphone.
WHATSAPP_PHONE_ID=
# Version de l'API Graph de Meta (facultatif)
WHATSAPP_API_VERSION=v23.0
# Nombre maximum de messages envoyés par jour (garde-fou contre une erreur de facturation)
WHATSAPP_DAILY_LIMIT=300

# Expéditeur des e-mails de rapport (par défaut : adresse d'essai de Resend, qui n'envoie qu'au propriétaire du compte Resend)
# REPORT_FROM=WEBSERVICES FIN <onboarding@resend.dev>
