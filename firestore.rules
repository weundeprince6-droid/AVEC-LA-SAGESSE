rules_version = '2';

// Règles de sécurité de la base AVEC LA SAGESSE.
// À coller dans Firebase Console > Firestore Database > onglet « Règles » > Publier.
//
// Principe :
//  - l'administrateur principal (un e-mail VÉRIFIÉ, à écrire ci-dessous) peut tout faire, y compris supprimer ;
//  - les personnes de l'équipe (collection staff, gérée dans l'application) ont soit l'accès total,
//    soit un « poste » : tout lire, saisir et corriger, mais PAS supprimer ;
//  - un membre connecté ne peut lire QUE sa propre fiche, ses réclamations et ses demandes ;
//  - un membre ne peut rien modifier : il peut seulement créer une réclamation ou une demande
//    à son nom, et marquer son mot de passe par défaut comme changé.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // >>> REMPLACEZ par l'adresse e-mail de l'administrateur principal, en minuscules <<<
    // Les autres personnes (postes, autres administrateurs) s'ajoutent ensuite DANS L'APPLICATION
    // (section « Équipe & Postes »), sans toucher à ces règles.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function rootAdmin() {
      return verified() && request.auth.token.email == 'votre-email@exemple.com';
    }
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email);
    }
    // Niveau d'un membre de l'équipe : 'total' (tous les droits) ou 'poste' (tout sauf supprimer)
    function staffLevel() {
      return get(staffPath()).data.level;
    }
    // Droits complets, y compris supprimer
    function isAdmin() {
      return rootAdmin() || (verified() && exists(staffPath()) && staffLevel() == 'total');
    }
    // Peut saisir et modifier (mais pas supprimer, sauf si isAdmin)
    function isStaff() {
      return isAdmin() || (verified() && exists(staffPath()) && staffLevel() == 'poste');
    }
    // Un poste ne peut pas faire disparaître des crédits, des cotisations / aides « cas sociaux »
    // ni des lignes d'historique d'une fiche
    function nothingRemoved() {
      return request.resource.data.get('credits', []).size() >= resource.data.get('credits', []).size()
        && request.resource.data.get('social', []).size() >= resource.data.get('social', []).size()
        && request.resource.data.get('socialAid', []).size() >= resource.data.get('socialAid', []).size()
        && request.resource.data.get('occ', []).size() >= resource.data.get('occ', []).size()
        && request.resource.data.get('collectes', []).size() >= resource.data.get('collectes', []).size()
        && (request.resource.data.get('history', []).size() >= resource.data.get('history', []).size()
            || resource.data.get('history', []).size() >= 200);
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function myMemberId() {
      return get(profilePath()).data.memberId;
    }

    // Numéro de version du compte d'un membre (permet de réinitialiser son mot de passe).
    // Lecture d'un seul document autorisée avant connexion ; pas de liste.
    match /loginIndex/{memberId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isStaff();
    }

    // Équipe : qui a un poste ou l'accès total. Géré par les administrateurs.
    match /staff/{email} {
      allow get: if isAdmin() || (verified() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Réglages : montant de la cotisation hebdomadaire « cas sociaux » (lu par tous, modifié par l'accès total)
    match /settings/{settingId} {
      allow read: if isStaff() || hasProfile();
      allow create, update: if isAdmin()
        && settingId == 'social'
        && request.resource.data.keys().hasOnly(['weekly', 'by', 'date'])
        && request.resource.data.weekly is number
        && request.resource.data.weekly > 0
        && request.resource.data.weekly <= 100000000;
      allow delete: if false;
    }

    // Profil complété par le membre lui-même (adresse, profession, personne à prévenir…).
    // Le membre écrit uniquement SON profil ; l'équipe le lit ; seul l'administrateur peut le supprimer.
    function okText(v, n) {
      return v is string && v.size() <= n;
    }
    match /memberProfiles/{profileId} {
      allow read: if isStaff() || (hasProfile() && myMemberId() == profileId);
      allow create, update: if hasProfile() && myMemberId() == profileId
        && request.resource.data.keys().hasOnly(['memberId', 'address', 'birth', 'profession', 'email', 'kinName', 'kinPhone', 'note', 'photo', 'updatedAt'])
        && request.resource.data.memberId == profileId
        && okText(request.resource.data.get('address', ''), 120)
        && okText(request.resource.data.get('birth', ''), 10)
        && okText(request.resource.data.get('profession', ''), 80)
        && okText(request.resource.data.get('email', ''), 80)
        && okText(request.resource.data.get('kinName', ''), 80)
        && okText(request.resource.data.get('kinPhone', ''), 25)
        && okText(request.resource.data.get('note', ''), 300)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 60000
            && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')));
      allow delete: if isAdmin();
    }

    // Annonces : écrites par l'équipe, lues par tous les membres connectés ayant un compte.
    match /announcements/{annId} {
      allow read: if isStaff() || hasProfile();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'date', 'title', 'text', 'important', 'by', 'poste'])
        && request.resource.data.id == annId
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.important is bool;
      allow delete: if isAdmin();
    }

    // Journal d'activité : chaque action de l'équipe y laisse une ligne, signée avec l'e-mail du compte.
    // Lisible par l'administrateur seulement ; une ligne ne peut jamais être modifiée.
    match /activity/{entryId} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'date', 'by', 'poste', 'text', 'memberId'])
        && request.resource.data.id == entryId
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Lien entre un compte de connexion et un membre.
    match /profiles/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
        && request.resource.data.mustChange == false
      );
    }

    // Fiche du membre : épargne, crédits, historique.
    match /members/{memberId} {
      allow read: if isStaff() || (hasProfile() && myMemberId() == memberId);
      allow create: if isStaff();
      allow update: if isAdmin() || (isStaff() && nothingRemoved());
      allow delete: if isAdmin();
    }

    // Réclamations.
    match /claims/{claimId} {
      allow read: if isStaff() || (hasProfile() && resource.data.memberId == myMemberId());
      allow create: if isStaff() || (
        hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'memberId', 'date', 'subject', 'message', 'status', 'response', 'responseDate'])
        && request.resource.data.id == claimId
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.subject in ['Épargne', 'Crédit', 'Remboursement', 'Autre']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'ouverte'
        && request.resource.data.response == ''
      );
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Demandes de crédit / retrait.
    match /requests/{requestId} {
      allow read: if isStaff() || (hasProfile() && resource.data.memberId == myMemberId());
      allow create: if isStaff() || (
        hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'memberId', 'type', 'amount', 'devise', 'note', 'date', 'status', 'decision', 'decisionDate'])
        && request.resource.data.id == requestId
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.type in ['credit', 'retrait']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.get('devise', 'USD') in ['USD', 'FC']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.status == 'en attente'
        && request.resource.data.decision == ''
      );
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
