rules_version = '2';

// Règles de sécurité de la base WEBSERVICES FIN.
// À coller dans Firebase Console > Firestore Database > onglet « Règles » > Publier.
//
// Principe :
//  - l'administrateur principal (un e-mail VÉRIFIÉ, à écrire ci-dessous) peut tout faire, y compris supprimer ;
//  - les personnes de l'équipe (collection staff, gérée dans l'application) ont soit l'accès total,
//    soit un « poste » : tout lire, saisir et corriger, mais PAS supprimer ;
//  - un membre connecté ne peut lire QUE sa propre fiche, ses réclamations et ses demandes ;
//  - un membre ne peut rien modifier : il peut seulement créer une réclamation ou une demande
//    à son nom, et marquer son mot de passe par défaut comme changé.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // >>> REMPLACEZ par l'adresse e-mail de l'administrateur principal, en minuscules <<<
    // Les autres personnes (postes, autres administrateurs) s'ajoutent ensuite DANS L'APPLICATION
    // (section « Équipe & Postes »), sans toucher à ces règles.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function rootAdmin() {
      return verified() && request.auth.token.email == 'votre-email@exemple.com';
    }
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email);
    }
    // Niveau d'un membre de l'équipe : 'total' (tous les droits) ou 'poste' (tout sauf supprimer)
    function staffLevel() {
      return get(staffPath()).data.level;
    }
    // Droits complets, y compris supprimer
    function isAdmin() {
      return rootAdmin() || (verified() && exists(staffPath()) && staffLevel() == 'total');
    }
    // Peut saisir et modifier (mais pas supprimer, sauf si isAdmin)
    function isStaff() {
      return isAdmin() || (verified() && exists(staffPath()) && staffLevel() == 'poste');
    }
    // Un poste ne peut pas faire disparaître des crédits, des cotisations / aides « cas sociaux »
    // ni des lignes d'historique d'une fiche
    function nothingRemoved() {
      return request.resource.data.get('credits', []).size() >= resource.data.get('credits', []).size()
        && request.resource.data.get('social', []).size() >= resource.data.get('social', []).size()
        && request.resource.data.get('socialAid', []).size() >= resource.data.get('socialAid', []).size()
        && request.resource.data.get('occ', []).size() >= resource.data.get('occ', []).size()
        && request.resource.data.get('collectes', []).size() >= resource.data.get('collectes', []).size()
        && (request.resource.data.get('history', []).size() >= resource.data.get('history', []).size()
            || resource.data.get('history', []).size() >= 200);
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(profilePath());
    }
    function myMemberId() {
      return get(profilePath()).data.memberId;
    }

    // Numéro de version du compte d'un membre (permet de réinitialiser son mot de passe).
    // Lecture d'un seul document autorisée avant connexion ; pas de liste.
    match /loginIndex/{memberId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isStaff();
    }

    // Équipe : qui a un poste ou l'accès total. Géré par les administrateurs.
    match /staff/{email} {
      allow get: if isAdmin() || (verified() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Réglages : « social » = cotisation hebdomadaire (lue par tous, modifiée par l'accès total) ;
    // « whatsapp » = envoi manuel ou automatique, « report » = rapport mensuel par e-mail (lus par l'équipe, modifiés par l'accès total)
    match /settings/{settingId} {
      allow read: if settingId == 'org' || isStaff() || (hasProfile() && settingId == 'social');
      allow create, update: if isAdmin() && (
        (settingId == 'org'
          && request.resource.data.keys().hasOnly(['name', 'logo', 'ratio', 'by', 'date'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
          && request.resource.data.logo is string && request.resource.data.logo.size() <= 150000
          && (request.resource.data.logo == '' || request.resource.data.logo[0:23] == 'data:image/jpeg;base64,')
          && request.resource.data.ratio is number)
        || (settingId == 'social'
          && request.resource.data.keys().hasOnly(['weekly', 'by', 'date'])
          && request.resource.data.weekly is number
          && request.resource.data.weekly > 0
          && request.resource.data.weekly <= 100000000)
        || (settingId == 'whatsapp'
          && request.resource.data.keys().hasOnly(['mode', 'autoOps', 'template', 'lang', 'by', 'date'])
          && request.resource.data.mode in ['manual', 'auto']
          && request.resource.data.autoOps is bool
          && request.resource.data.template is string && request.resource.data.template.size() <= 60
          && request.resource.data.lang is string && request.resource.data.lang.size() <= 10)
        || (settingId == 'report'
          && request.resource.data.keys().hasOnly(['enabled', 'to', 'by', 'date', 'lastAt', 'lastStatus', 'lastError'])
          && request.resource.data.enabled is bool
          && request.resource.data.to is string && request.resource.data.to.size() <= 80
          && (request.resource.data.to == '' || request.resource.data.to.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$'))));
      allow delete: if false;
    }

    // File d'envoi WhatsApp automatique : l'équipe dépose un message (statut « pending »), la Cloud Function
    // l'envoie via Meta puis met à jour le statut (elle n'est pas soumise à ces règles). Personne ne modifie une ligne.
    match /whatsappQueue/{qid} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'date', 'to', 'text', 'kind', 'memberId', 'status', 'by'])
        && request.resource.data.id == qid
        && request.resource.data.status == 'pending'
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.to is string && request.resource.data.to.matches('^[0-9]{8,15}$')
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.kind in ['situation', 'rappel', 'recu', 'annonce', 'diffusion']
        && okText(request.resource.data.memberId, 40)
        && okText(request.resource.data.date, 40);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Demandes d'envoi immédiat du rapport PDF par e-mail : déposées par l'accès total, traitées par la Cloud Function.
    match /reportRequests/{rid} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'date', 'by', 'status'])
        && request.resource.data.id == rid
        && request.resource.data.status == 'pending'
        && request.resource.data.by == request.auth.token.email
        && okText(request.resource.data.date, 40);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Profil complété par le membre lui-même (adresse, profession, personne à prévenir…).
    // Le membre écrit uniquement SON profil ; l'équipe le lit ; seul l'administrateur peut le supprimer.
    function okText(v, n) {
      return v is string && v.size() <= n;
    }
    match /memberProfiles/{profileId} {
      allow read: if isStaff() || (hasProfile() && myMemberId() == profileId);
      allow create, update: if ((hasProfile() && myMemberId() == profileId) || isAdmin())
        && request.resource.data.keys().hasOnly(['memberId', 'address', 'birth', 'profession', 'email', 'kinName', 'kinPhone', 'note', 'photo', 'updatedAt'])
        && request.resource.data.memberId == profileId
        && okText(request.resource.data.get('address', ''), 120)
        && okText(request.resource.data.get('birth', ''), 10)
        && okText(request.resource.data.get('profession', ''), 80)
        && okText(request.resource.data.get('email', ''), 80)
        && okText(request.resource.data.get('kinName', ''), 80)
        && okText(request.resource.data.get('kinPhone', ''), 25)
        && okText(request.resource.data.get('note', ''), 300)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 60000
            && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')));
      allow delete: if isAdmin();
    }

    // Inscriptions : n'importe qui (sans connexion) peut DÉPOSER une demande, avec des champs limités ;
    // seule l'équipe peut les lire, les accepter ou les refuser. L'administrateur seul peut les supprimer.
    match /registrations/{rid} {
      allow create: if request.resource.data.keys().hasOnly(['id', 'date', 'status', 'name', 'phone', 'address', 'birth', 'profession', 'email', 'kinName', 'kinPhone', 'note', 'photo', 'groupId'])
        && (!('groupId' in request.resource.data) || (request.resource.data.groupId is string && request.resource.data.groupId.size() <= 20 && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))))
        && request.resource.data.keys().hasAll(['id', 'date', 'status', 'name', 'phone'])
        && request.resource.data.id == rid
        && rid.size() <= 40
        && request.resource.data.status == 'pending'
        && okText(request.resource.data.date, 40)
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 6 && request.resource.data.phone.size() <= 25
        && okText(request.resource.data.get('address', ''), 120)
        && okText(request.resource.data.get('birth', ''), 10)
        && okText(request.resource.data.get('profession', ''), 80)
        && okText(request.resource.data.get('email', ''), 80)
        && okText(request.resource.data.get('kinName', ''), 80)
        && okText(request.resource.data.get('kinPhone', ''), 25)
        && okText(request.resource.data.get('note', ''), 300)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 60000
            && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')));
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'memberId', 'decidedBy', 'decidedAt'])
        && request.resource.data.status in ['accepted', 'refused'];
      allow delete: if isAdmin();
    }

    // Annonces : écrites par l'équipe, lues par tous les membres connectés ayant un compte.
    match /announcements/{annId} {
      allow read: if isStaff() || hasProfile();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'date', 'title', 'text', 'important', 'by', 'poste'])
        && request.resource.data.id == annId
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.important is bool;
      allow delete: if isAdmin();
    }

    // Journal d'activité : chaque action de l'équipe y laisse une ligne, signée avec l'e-mail du compte.
    // Lisible par l'administrateur seulement ; une ligne ne peut jamais être modifiée.
    match /activity/{entryId} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'date', 'by', 'poste', 'text', 'memberId'])
        && request.resource.data.id == entryId
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Lien entre un compte de connexion et un membre.
    match /profiles/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
        && request.resource.data.mustChange == false
      );
    }

    // Fiche du membre : épargne, crédits, historique.
    match /members/{memberId} {
      allow read: if isStaff() || (hasProfile() && myMemberId() == memberId)
        || (hasProfile() && resource.data.get('groupId', '') == myMemberId() && exists(/databases/$(database)/documents/groups/$(myMemberId())));   // le chef de groupe lit les fiches de son groupe
      allow create: if isStaff();
      allow update: if isAdmin() || (isStaff() && nothingRemoved());
      allow delete: if isAdmin();
    }

    // Réclamations.
    match /claims/{claimId} {
      allow read: if isStaff() || (hasProfile() && resource.data.memberId == myMemberId());
      allow create: if isStaff() || (
        hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'memberId', 'date', 'subject', 'message', 'status', 'response', 'responseDate'])
        && request.resource.data.id == claimId
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.subject in ['Épargne', 'Crédit', 'Remboursement', 'Autre']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'ouverte'
        && request.resource.data.response == ''
      );
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Demandes de crédit / retrait.
    match /requests/{requestId} {
      allow read: if isStaff() || (hasProfile() && resource.data.memberId == myMemberId());
      allow create: if isStaff() || (
        hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'memberId', 'type', 'amount', 'devise', 'note', 'date', 'status', 'decision', 'decisionDate'])
        && request.resource.data.id == requestId
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.type in ['credit', 'retrait']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.get('devise', 'USD') in ['USD', 'FC']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.status == 'en attente'
        && request.resource.data.decision == ''
      );
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- Boutique des membres ----------
    function myName() {
      return get(/databases/$(database)/documents/members/$(myMemberId())).data.name;
    }
    // Pour publier un article, le membre doit avoir versé de l'épargne dans les 14 derniers jours
    // (la fiche porte lastEpargneDay = numéro du jour du dernier versement, tenu à jour par l'application).
    function activeSaver() {
      return (get(/databases/$(database)/documents/members/$(myMemberId())).data.get('lastEpargneDay', 0) + 15) * 86400000 >= request.time.toMillis();
    }
    function itemOf(id) {
      return get(/databases/$(database)/documents/items/$(id)).data;
    }

    // Boutique : une par membre (document = identifiant du membre). Visible tout de suite ; l'équipe peut la masquer.
    match /shops/{shopId} {
      allow read: if isStaff() || (hasProfile() && (resource.data.status == 'validée' || shopId == myMemberId()));
      allow create: if isStaff() || (
        hasProfile() && shopId == myMemberId()
        && request.resource.data.keys().hasOnly(['id', 'ownerId', 'ownerName', 'name', 'desc', 'contact', 'status', 'date'])
        && request.resource.data.id == shopId && request.resource.data.ownerId == shopId
        && request.resource.data.ownerName == myName()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 300
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 60
        && request.resource.data.status == 'validée'
      );
      // le membre modifie les textes de sa boutique, jamais son statut (la validation reste à l'équipe)
      allow update: if isStaff() || (
        hasProfile() && shopId == myMemberId()
        && request.resource.data.keys().hasOnly(['id', 'ownerId', 'ownerName', 'name', 'desc', 'contact', 'status', 'date'])
        && request.resource.data.status == resource.data.status
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 300
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 60
      );
      allow delete: if isAdmin();
    }

    // Articles : publiés tout de suite par le vendeur ; l'équipe peut les masquer (le vendeur ne peut alors plus les remettre).
    match /items/{itemId} {
      allow read: if isStaff() || (hasProfile() && (resource.data.status == 'publié' || resource.data.ownerId == myMemberId()));
      allow create: if isStaff() || (
        hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'ownerId', 'ownerName', 'shopName', 'title', 'desc', 'price', 'devise', 'qty', 'photo', 'status', 'date'])
        && request.resource.data.id == itemId
        && request.resource.data.ownerId == myMemberId()
        && request.resource.data.ownerName == myName()
        && exists(/databases/$(database)/documents/shops/$(myMemberId()))
        && activeSaver()
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 300
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 100000000
        && request.resource.data.devise in ['USD', 'FC']
        && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 999
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 120000
        && request.resource.data.status == 'publié'
      );
      // le vendeur peut modifier son article, le retirer ou le remettre en vente ; s'il a été masqué par l'équipe, il ne peut plus y toucher
      allow update: if isStaff() || (
        hasProfile() && resource.data.ownerId == myMemberId()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && resource.data.status in ['publié', 'retiré']
        && request.resource.data.status in ['publié', 'retiré']
        && (request.resource.data.status == 'retiré' || activeSaver())
        && request.resource.data.keys().hasOnly(['id', 'ownerId', 'ownerName', 'shopName', 'title', 'desc', 'price', 'devise', 'qty', 'photo', 'status', 'date'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 300
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 100000000
        && request.resource.data.devise in ['USD', 'FC']
        && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 999
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 120000
      );
      allow delete: if isAdmin() || (hasProfile() && resource.data.ownerId == myMemberId() && resource.data.status != 'vendu');
    }

    // Commandes : créées par l'acheteur ; le vendeur accepte ou refuse ; l'équipe conclut (c'est elle qui déplace l'argent).
    // Sous-groupes : un groupe = un chef de groupe (un membre) ; l'identifiant du groupe est celui de son chef.
    // L'équipe crée, modifie et dissout les groupes ; le nom du groupe se lit à l'unité (page d'inscription du groupe).
    match /groups/{groupId} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'name', 'leaderId', 'leaderName', 'status', 'date', 'by'])
        && request.resource.data.id == groupId
        && request.resource.data.leaderId == groupId
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.leaderName is string && request.resource.data.leaderName.size() <= 80
        && request.resource.data.status in ['actif', 'suspendu']
        && request.resource.data.date is string && request.resource.data.by is string
        && exists(/databases/$(database)/documents/members/$(groupId));
      allow delete: if isAdmin();
    }
    // Opérations proposées par un chef de groupe pour un membre de son groupe : l'argent ne bouge qu'à la validation par l'équipe
    match /groupOps/{opId} {
      allow read: if isStaff() || (hasProfile() && resource.data.groupId == myMemberId());
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'groupId', 'memberId', 'memberName', 'leaderName', 'type', 'amount', 'devise', 'creditId', 'note', 'status', 'date'])
        && request.resource.data.id == opId
        && request.resource.data.groupId == myMemberId()
        && exists(/databases/$(database)/documents/groups/$(myMemberId()))
        && get(/databases/$(database)/documents/members/$(request.resource.data.memberId)).data.get('groupId', '') == myMemberId()
        && request.resource.data.type in ['epargne', 'remboursement']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
        && request.resource.data.devise in ['USD', 'FC']
        && request.resource.data.creditId is string && request.resource.data.creditId.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.memberName is string && request.resource.data.memberName.size() <= 80
        && request.resource.data.leaderName is string && request.resource.data.leaderName.size() <= 80
        && request.resource.data.status == 'à valider';
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote'])
        && request.resource.data.status in ['validée', 'refusée'];
      allow delete: if isAdmin() || (hasProfile() && resource.data.groupId == myMemberId() && resource.data.status == 'à valider');
    }

    // Exposition : publications de l'équipe (photos, liens vidéo / documents), « j'aime » et commentaires des membres
    match /posts/{postId} {
      allow read: if isStaff() || (hasProfile() && resource.data.status == 'publié');
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'title', 'text', 'images', 'videoUrl', 'docUrl', 'docName', 'docData', 'status', 'date', 'by'])
        && request.resource.data.id == postId
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.images is list && request.resource.data.images.size() <= 3
        && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() <= 300
        && request.resource.data.docUrl is string && request.resource.data.docUrl.size() <= 300
        && request.resource.data.docName is string && request.resource.data.docName.size() <= 60
        && request.resource.data.docData is string && request.resource.data.docData.size() <= 480000
        && request.resource.data.status in ['publié', 'masqué']
        && request.resource.data.date is string && request.resource.data.by is string;
      allow delete: if isAdmin();
    }
    match /postLikes/{likeId} {
      allow read: if isStaff() || hasProfile();
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly(['postId', 'memberId', 'date'])
        && request.resource.data.memberId == myMemberId()
        && likeId == request.resource.data.postId + '_' + myMemberId()
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.status == 'publié';
      allow delete: if isStaff() || (hasProfile() && resource.data.memberId == myMemberId());
      allow update: if false;
    }
    match /postComments/{commentId} {
      allow read: if isStaff() || hasProfile();
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'postId', 'memberId', 'name', 'text', 'date', 'photo'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is int && request.resource.data.photo >= 0 && request.resource.data.photo <= 2))
        && request.resource.data.id == commentId
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.name == myName()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.status == 'publié';
      allow delete: if isAdmin() || (hasProfile() && resource.data.memberId == myMemberId());
      allow update: if false;
    }

    match /orders/{orderId} {
      allow read: if isStaff() || (hasProfile() && (resource.data.buyerId == myMemberId() || resource.data.sellerId == myMemberId()));
      allow create: if isStaff() || (
        hasProfile()
        && request.resource.data.keys().hasOnly(['id', 'itemId', 'itemTitle', 'sellerId', 'sellerName', 'buyerId', 'buyerName', 'price', 'devise', 'commission', 'net', 'qty', 'note', 'status', 'decision', 'date', 'decisionDate'])
        && request.resource.data.id == orderId
        && request.resource.data.buyerId == myMemberId()
        && request.resource.data.buyerName == myName()
        && request.resource.data.sellerId != myMemberId()
        && itemOf(request.resource.data.itemId).status == 'publié'
        && itemOf(request.resource.data.itemId).ownerId == request.resource.data.sellerId
        && itemOf(request.resource.data.itemId).price == request.resource.data.price
        && itemOf(request.resource.data.itemId).devise == request.resource.data.devise
        && request.resource.data.qty == 1
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.status == 'en attente'
        && request.resource.data.decision == ''
      );
      allow update: if isStaff() || (
        hasProfile() && (
          (resource.data.sellerId == myMemberId() && resource.data.status == 'en attente'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'decisionDate'])
            && request.resource.data.status in ['acceptée', 'refusée'])
          || (resource.data.buyerId == myMemberId() && resource.data.status in ['en attente', 'acceptée']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decision', 'decisionDate'])
            && request.resource.data.status == 'annulée')
        )
      );
      allow delete: if isAdmin();
    }
  }
}
